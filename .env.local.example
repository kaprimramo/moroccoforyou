# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never leaves your machine (or Vercel).

# ── AI Travel Planner ────────────────────────────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_ — that would ship it to browsers.
OPENAI_API_KEY=sk-...

# Where the AIPlanner client component sends requests. Point at our own route
# unless you're proxying through a separate worker.
NEXT_PUBLIC_AI_API_URL=/api/planner

# ── Optional integrations ────────────────────────────────────────────────────
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=
